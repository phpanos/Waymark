{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waymark",
  "version": "0.1.53",
  "identifier": "app.waymark.overlay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Waymark",
        "width": 328,
        "height": 172,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Waymark settings",
        "url": "index.html?view=settings",
        "width": 494,
        "height": 666,
        "minWidth": 370,
        "minHeight": 420,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": { "pubkey": "" }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/waymark.ico"
    ]
  }
}
